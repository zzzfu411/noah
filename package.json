{
  "name": "noah-local",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "description": "Local communication between independent Grok and Pi harnesses",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node scripts/start-desktop.ts",
    "doctor": "node scripts/doctor.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.ts",
    "dev:web": "node src/server.ts",
    "open:web": "node scripts/open.ts",
    "icons:mac": "swift scripts/make-icon.swift",
    "prepackage:mac": "npm run icons:mac",
    "package:mac": "electron-builder --mac --arm64 --dir --publish never",
    "check:ui": "node scripts/check-desktop-ui.mjs",
    "check:release": "node scripts/check-release.cjs",
    "install:mac": "node scripts/install-mac.cjs",
    "verify:pi-native": "node scripts/verify-pi-native.ts",
    "verify:grok-transport": "node scripts/check-grok-bridge-transport.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.87.0",
    "@earendil-works/pi-coding-agent": "0.87.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "smol-toml": "1.8.0",
    "typebox": "1.3.27",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2"
  },
  "productName": "Noah",
  "main": "desktop/main.cjs",
  "author": "Noah"
}
